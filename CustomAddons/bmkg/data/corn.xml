<odoo>
    <record id="ir_cron_fetch_gempa" model="ir.cron">
        <field name="name">Fetch API Gempa BMKG</field>
        <field name="model_id" ref="model_gempa_cron"/>
        <field name="state">code</field>
        <field name="code">model.cron_fetch_gempa()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
